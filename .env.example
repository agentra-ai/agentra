# Generate a runnable .env with strong random credentials:
#   ./scripts/bootstrap-env.sh
# This template intentionally leaves secrets blank so a copied file fails closed.

# Database
POSTGRES_DB=agentra
POSTGRES_USER=agentra
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=

# Server
PORT=8080
SERVER_INTERNAL_PORT=8080
SERVER_HEALTHCHECK_URL=http://server:8080/readyz
JWT_SECRET=
SERVER_BIND_ADDRESS=127.0.0.1

# Local loopback callback used by `agentra login` on the machine running the CLI
AGENTRA_LOCAL_BIND_HOST=127.0.0.1
AGENTRA_CALLBACK_HOST=localhost

# Public service URLs used by the CLI and web app
AGENTRA_SERVER_URL=ws://127.0.0.1:8080/ws
AGENTRA_APP_URL=http://127.0.0.1:3000

# Host-mode CLI / daemon overrides. Set these to publicly reachable URLs; the
# optional gateway has its own Docker-internal GATEWAY_SERVER_URL below.
# These override AGENTRA_SERVER_URL / AGENTRA_APP_URL only for the host
# CLI/daemon paths.
AGENTRA_CLI_SERVER_URL=http://127.0.0.1:8080
AGENTRA_CLI_APP_URL=http://127.0.0.1:3000
AGENTRA_DAEMON_CONFIG=
AGENTRA_WORKSPACE_ID=
AGENTRA_DAEMON_ID=
AGENTRA_DAEMON_DEVICE_NAME=
AGENTRA_DAEMON_POLL_INTERVAL=3s
AGENTRA_DAEMON_HEARTBEAT_INTERVAL=15s
AGENTRA_CODEX_PATH=codex
AGENTRA_CODEX_MODEL=
AGENTRA_CODEX_WORKDIR=
AGENTRA_CODEX_TIMEOUT=20m

# Optional Cloud Runtime Gateway (`docker compose --profile cloud-runtime up`).
# AGENTRA_AUTH_TOKEN must be a JWT or PAT for a workspace owner/admin;
# the gateway sends it only in the WebSocket Authorization header.
GATEWAY_SERVER_URL=ws://server:8080/ws
GATEWAY_ID=gateway-1
GATEWAY_WORKSPACE_ID=
AGENTRA_AUTH_TOKEN=
DOCKER_HOST=unix:///var/run/docker.sock
BASE_IMAGE=agentra/agent-runtime:latest
GATEWAY_STATE_DIR=/var/lib/agentra-gateway

# Email delivery. `console` returns the OTP in the API response and is only for
# local development; production requires `resend` or `smtp`.
APP_ENV=development
EMAIL_PROVIDER=console
EMAIL_FROM='Agentra <noreply@agentra.ai>'
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=10s

# Access policy. The signup allowlist accepts exact addresses and @domain
# entries. Pre-provisioned/invited users can still log in when signup is off.
AGENTRA_SIGNUP_DISABLED=false
AGENTRA_SIGNUP_ALLOWLIST=
AGENTRA_WORKSPACE_CREATION_DISABLED=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# S3 / CloudFront
S3_BUCKET=
S3_REGION=us-west-2
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_SECRET=agentra/cloudfront-signing-key
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_DOMAIN=
COOKIE_DOMAIN=

# MinIO (local S3-compatible object storage)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=agentra-uploads

# Frontend
FRONTEND_PORT=3000
WEB_INTERNAL_PORT=3000
WEB_HOSTNAME=0.0.0.0
WEB_BIND_ADDRESS=127.0.0.1

# Public frontend and API origins
FRONTEND_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8080/ws

# Hosts accepted for the browser -> local CLI callback handoff
NEXT_PUBLIC_CLI_CALLBACK_HOSTS=localhost,127.0.0.1

# Remote API (optional) — set to proxy local frontend to a remote backend
# Leave empty to use NEXT_PUBLIC_API_URL
REMOTE_API_URL=
